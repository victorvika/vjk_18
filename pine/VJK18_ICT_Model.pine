i_majRight   = input.int(10, "LTF Major swing right bars", minval = 1, maxval = 100, group = G02)
i_htfMajLeft = input.int(3, "HTF Major swing left bars", minval = 1, maxval = 50, group = G02)
i_htfMajRight= input.int(3, "HTF Major swing right bars", minval = 1, maxval = 50, group = G02)
i_htfRangeLb = input.int(50, "HTF range-extreme lookback", minval = 5, maxval = 500, group = G02)
i_showMajSw  = input.bool(false, "Show LTF major swings", group = G02)

