//@version=6
// =============================================================================================
//  VJK-18  |  ICT EXTERNAL LIQUIDITY SWEEP -> HTF FVG -> LTF MSS -> BREAKER  (NON-REPAINTING)
// =============================================================================================
//  Causal chain implemented (mandatory, in order):
//     EXTERNAL LIQUIDITY -> SWEEP -> HTF FVG -> LTF MSS -> BREAKER/MITIGATION ZONE
//     -> LIMIT ENTRY -> SL beyond sweep/swing extreme -> TP at OPPOSING LIQUIDITY
//
//  Every mandatory condition is a hard gate (see "SIGNAL VALIDATION MATRIX" section below).
//  If ANY mandatory component is missing the PRIMARY signal is NOT produced.
//
//  Repainting guarantees:
//    * All pivots are CONFIRMED pivots (right-side bars must be closed).
//    * All HTF data comes from request.security(..., lookahead = barmerge.lookahead_off)
//      with a +1 offset, i.e. ONLY CLOSED HTF candles are ever used.
//    * Every state transition and every signal is evaluated on a CLOSED chart bar.
//    * Never uses request.security(..., lookahead_on) and never uses future offsets.
// =============================================================================================

indicator("VJK-18 ICT Model", "VJK-18 ICT", true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// =============================================================================================
//  INPUT GROUPS
// =============================================================================================
string G01 = "01 - Timeframe Engine"
string G02 = "02 - Major Market Structure"
string G03 = "03 - Internal Market Structure"
string G04 = "04 - External Liquidity"
string G05 = "05 - Liquidity Sweep"
string G06 = "06 - HTF Fair Value Gap"
string G07 = "07 - LTF MSS"
string G08 = "08 - Breaker Block"
string G09 = "09 - Mitigation Block"
string G10 = "10 - Entry Model"
string G11 = "11 - Stop Loss"
string G12 = "12 - Target Liquidity"
string G13 = "13 - Risk / Reward"
string G14 = "14 - Visual Settings"
string G15 = "15 - Dashboard"
string G16 = "16 - Alerts"
string G17 = "17 - Debug"

// --------------------------------------- 01 - TIMEFRAME ENGINE ------------------------------
i_htfMode = input.string("Auto", "HTF Resolution", options = ["Auto", "Manual"], group = G01, tooltip = "Auto: 1M->15M, 5M->1H, 15M->4H.")
i_htfManual  = input.timeframe("60", "Manual HTF", group = G01, tooltip = "Used when HTF Resolution = Manual. Two TF levels above the chart.")
i_minHtfRatio = input.float(4.0, "Minimum HTF/LTF ratio warning", minval = 1.0, step = 0.5, group = G01, tooltip = "Warning below this ratio. Reference model: 12x-16x.")
i_showTfWarn = input.bool(true, "Show timeframe warning on chart", group = G01)
i_htfDepth   = input.int(200, "HTF candle history depth", minval = 50, maxval = 500, group = G01, tooltip = "Confirmed HTF candles kept in memory.")

// --------------------------------------- 02 - MAJOR MARKET STRUCTURE ------------------------
