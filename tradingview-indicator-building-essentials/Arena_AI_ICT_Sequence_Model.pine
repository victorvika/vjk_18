iMssMinAtr     = input.float(0.10, "Min. break distance (x ATR)", minval = 0.0, step = 0.05, group = gMss)
iShowMssLbl    = input.bool(true, "Show MSS labels", group = gMss)
iShowBosLbl    = input.bool(false, "Show BOS / CHoCH labels", group = gMss)

// =============================================================================
