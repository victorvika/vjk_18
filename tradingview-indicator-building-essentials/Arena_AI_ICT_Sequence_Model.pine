iHtfFvgOn      = input.bool(true, "Detect HTF fair value gaps", group = gHf)
iHtfFvgMax     = input.int(4, "Max. HTF FVGs kept", minval = 1, maxval = 20, group = gHf)
iHtfFvgMinPct  = input.float(0.05, "Min. gap size (% of price)", minval = 0.0, step = 0.01, group = gHf)
iHtfFvgDist    = input.float(4.0, "Max. sweep <-> HTF FVG distance (x ATR)", minval = 0.5, step = 0.5, group = gHf)
iShowHtfFvg    = input.bool(true, "Show HTF FVG zones", group = gHf)

// =============================================================================
