//@version=6
// =============================================================================
//  ARENA AI - ICT / SMC SEQUENCE MODEL
//  TradingView Masterclass Build - Pine Script v6
// -----------------------------------------------------------------------------
//  ONE complete institutional sequence, implemented as a deterministic
//  state machine (never an isolated "BUY" because a single condition fired):
//
//     EXTERNAL RANGE LIQUIDITY
//       -> LIQUIDITY SWEEP
//         -> HTF FAIR VALUE GAP   (context)
//           -> LTF MARKET STRUCTURE SHIFT  (with displacement)
//             -> BREAKER BLOCK     (primary POI)
//               -> LIMIT ENTRY     (retracement into the breaker)
//                 -> STOP LOSS     (beyond the sweep extreme)
//                   -> OPPOSITE-SIDE LIQUIDITY TARGET
//
//  NON-REPAINTING GUARANTEES
//    * every state transition is gated by barstate.isconfirmed
//    * HTF data uses request.security(..., lookahead = barmerge.lookahead_off)
//      with [1]/[2]/[3] offsets, so only CLOSED HTF candles are ever read
//    * structure pivots come from ta.pivothigh()/ta.pivotlow() (confirmed only)
//    * printed signals are never moved, deleted or repainted
//
//  DELIBERATELY EXCLUDED: RSI, MACD, Stochastic, moving averages and any
//  generic "smart money" feature that is not part of the masterclass model.
// =============================================================================
indicator("Arena AI - ICT Sequence Model [Masterclass]", "Arena AI SMC", overlay = true,
     max_bars_back    = 1000,
     max_lines_count  = 500,
     max_labels_count = 500,
     max_boxes_count  = 500)

// =============================================================================
//  1 - GENERAL
// =============================================================================
string gGen    = "1 - General"
iDashOn        = input.bool(false, "Show dashboard", group = gGen)
iShowSignals   = input.bool(true,  "Show signal labels (BUY LIMIT / SELL LIMIT)", group = gGen)
iMaxAge        = input.int(600, "Max. liquidity age (bars)", minval = 50, maxval = 5000, group = gGen)

// =============================================================================
//  2 - TIMEFRAMES
// =============================================================================
string gTf     = "2 - Timeframes"
iTfPreset      = input.string("1H -> 5M", "HTF / LTF mapping", options = ["1H -> 5M", "4H -> 15M", "15M -> 1M", "Custom"], group = gTf)
iHtfCustom     = input.timeframe("60", "Custom HTF", group = gTf)
iLtfCustom     = input.timeframe("5",  "Custom LTF", group = gTf)
iTfWarn        = input.bool(true, "Warn when the chart is not the LTF", group = gTf)
iRequireHtf    = input.bool(true, "Require HTF context (HTF FVG) for a setup", group = gTf)

// =============================================================================
//  3 - MARKET STRUCTURE
// =============================================================================
string gMs     = "3 - Market Structure"
iSwing         = input.int(5, "Internal swing length", minval = 1, maxval = 100, group = gMs)
iShowInternal  = input.bool(false, "Show internal structure", group = gMs)
iShowHHLL      = input.bool(false, "Show HH / HL / LH / LL labels", group = gMs)
iConfirmClose  = input.bool(true,  "Require a candle close to confirm BOS", group = gMs)
iStructLookBk  = input.int(200, "Structure / protected level lookback (bars)", minval = 20, maxval = 500, group = gMs)

// =============================================================================
//  4 - EXTERNAL LIQUIDITY
// =============================================================================
string gExt    = "4 - External Liquidity"
iExtSwing      = input.int(20, "External swing strength (pivot sensitivity)", minval = 3, maxval = 200, group = gExt)
iRangeLookBk   = input.int(120, "External range lookback (bars)", minval = 20, maxval = 1000, group = gExt)
iMaxLevels     = input.int(12, "Max. external levels kept", minval = 3, maxval = 40, group = gExt)
iShowLiq       = input.bool(true, "Show liquidity levels", group = gExt)
iRequireExt    = input.bool(true, "Setups require external liquidity (ignore internal sweeps)", group = gExt)

// =============================================================================
//  5 - EQUAL HIGHS / EQUAL LOWS
// =============================================================================
string gEq     = "5 - Equal Highs / Equal Lows"
iEqOn          = input.bool(true, "Detect equal highs / equal lows", group = gEq)
iEqTolMode     = input.string("ATR based", "Equality tolerance mode", options = ["ATR based", "Ticks", "Percent"], group = gEq)
iEqTolAtr      = input.float(0.25, "Tolerance (x ATR)", minval = 0.01, step = 0.05, group = gEq)
iEqTolTicks    = input.int(15, "Tolerance (ticks)", minval = 1, group = gEq)
iEqTolPct      = input.float(0.05, "Tolerance (% of price)", minval = 0.001, step = 0.01, group = gEq)
iEqMinBars     = input.int(5, "Min. bars between equal points", minval = 1, group = gEq)

// =============================================================================
//  6 - LIQUIDITY SWEEP
// =============================================================================
string gSw     = "6 - Liquidity Sweep"
iSweepMode     = input.string("Wick + close back inside", "Sweep confirmation", options = ["Wick penetration", "Wick + close back inside", "Strict rejection"], group = gSw)
iMinPenTicks   = input.int(0, "Minimum penetration (ticks)", minval = 0, group = gSw)
iReclaimBars   = input.int(3, "Reclaim window (bars)", minval = 1, maxval = 50, group = gSw)
iStrictAtr     = input.float(0.5, "Strict rejection strength (x ATR)", minval = 0.1, step = 0.1, group = gSw)
iMaxSweepMss   = input.int(30, "Max. bars sweep -> MSS", minval = 3, maxval = 200, group = gSw)
iShowSweepLbl  = input.bool(true, "Show sweep labels", group = gSw)

// =============================================================================
