// =============================================================================
string gDisp   = "9 - Displacement"
iDispOn        = input.bool(true, "Require displacement for the MSS", group = gDisp)
iDispBodyRatio = input.float(0.50, "Body / range ratio", minval = 0.1, maxval = 1.0, step = 0.05, group = gDisp)
iDispRangeAtr  = input.float(0.80, "Minimum range (x ATR)", minval = 0.1, step = 0.1, group = gDisp)
iDispBodyAtr   = input.float(0.30, "Minimum body (x ATR)", minval = 0.05, step = 0.05, group = gDisp)
