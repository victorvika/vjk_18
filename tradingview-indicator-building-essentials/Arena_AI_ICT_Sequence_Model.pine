iAlMss         = input.bool(true, "MSS confirmed", group = gAl)
iAlBrk         = input.bool(true, "Breaker created", group = gAl)
iAlArmed       = input.bool(true, "BUY LIMIT / SELL LIMIT armed", group = gAl)
