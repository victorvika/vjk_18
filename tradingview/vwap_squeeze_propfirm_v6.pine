//@version=6
// =============================================================================
//  VWAP + SQUEEZE MOMENTUM  -  PROP-FIRM READY INTRADAY STRATEGY
//  TradingView Pine Script v6
// =============================================================================
//  Signal core  : "Squeeze Momentum Indicator" by LazyBear (John Carter TTM
//                  Squeeze) - OPEN SOURCE, published 2014, ~117k likes.
//                  https://www.tradingview.com/script/nqQ1DT5a-Squeeze-Momentum-Indicator-LazyBear/
//  Filters      : session VWAP bias  +  higher timeframe (15m) EMA trend
//  Risk         : ATR stop + R-multiple target, fixed-fractional sizing
//  Prop guard   : daily-loss lock, max trades/day, flat before the close,
//                  consistency (best day) tracker
//
//  This is a REIMPLEMENTATION of the public LazyBear logic (credit: LazyBear,
//  book "Mastering the Trade" by John F. Carter) - not a copy of his source.
//
//  Non-repainting: every condition uses CLOSED bar values; entries are filled
//  by the strategy engine on the NEXT bar's open.
//
//  BACKTESTED PARITY: the same logic is implemented in backtest/strategy.py +
//  backtest/backtest.py (1-minute QQQ/SPY data, 2024-10-31 -> 2025-11-07).
// =============================================================================
strategy("VWAP + Squeeze Momentum [Prop-Firm Intraday]", overlay = true,
     initial_capital      = 100000,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 1,
     pyramiding           = 0,
     commission_type      = strategy.commission.percent,
     commission_value     = 0,
     slippage             = 1,             // 1 tick = 0.01 for QQQ/SPY/most FX
     calc_on_every_tick   = false,
     process_orders_on_close = false,       // fill on next bar open (no repaint)
     max_boxes_count      = 200,
     max_labels_count     = 200)

// -----------------------------------------------------------------------------
// 1. INPUTS
// -----------------------------------------------------------------------------
g_core = "1) Squeeze Momentum core (LazyBear defaults)"
bbLen  = input.int(20, "Bollinger length",  minval = 5,          group = g_core)
bbMult = input.float(2.0, "Bollinger mult", minval = 0.5, step = 0.1, group = g_core)
kcLen  = input.int(20, "Keltner length",  minval = 5,           group = g_core)
kcMult = input.float(1.5, "Keltner mult",  minval = 0.5, step = 0.1, group = g_core)

g_filt = "2) Filters"
useVwap = input.bool(true, "Session VWAP bias filter", group = g_filt)
sessTZ  = input.session("0930-1600", "Session (use 0930-1600:America/New_York for US stocks)",
         group = g_filt)
useHtf  = input.bool(true, "HTF trend filter",       group = g_filt)
htfTf   = input.timeframe("15", "HTF timeframe",     group = g_filt)
htfLen  = input.int(50, "HTF EMA length", minval = 5, group = g_filt)
momK    = input.float(0.0, "Momentum strength (x ATR)", minval = 0, step = 0.1, group = g_filt,
         tooltip = "0 = off (DEFAULT, and the only setting that survived the\n" +
                   "out-of-sample test on both QQQ and SPY).\n" +
                   "Above 1.5 it looks amazing in-sample but the sample collapses\n" +
                   "to ~28 trades/year - a knife edge, not an edge.")
momSlope = input.bool(true, "Require rising momentum", group = g_filt,
         tooltip = "LazyBear's own rule: only take the trade when the momentum\n" +
                   "histogram is rising in your direction. Worth +0.065R per trade.")

g_risk = "3) Risk"
atrLen   = input.int(14,   "ATR length",            minval = 2,            group = g_risk)
stopMult = input.float(1.5, "ATR stop multiple",    minval = 0.5, step = 0.1, group = g_risk)
rr       = input.float(3.0, "Take profit (R multiple)", minval = 0.5, step = 0.1, group = g_risk)
riskPct  = input.float(0.5, "Risk per trade (% of equity)", minval = 0.05, step = 0.05, group = g_risk)

g_prop = "4) Prop-firm guardrails"
maxTradesDay = input.int(3, "Max trades per day", minval = 1, group = g_prop)
dailyStopPct = input.float(2.0, "Daily loss lock (% of day-start balance)", minval = 0.2,
         step = 0.25, group = g_prop,
         tooltip = "When day P&L reaches this, everything is closed and no more\n" +
                   "trades are taken that day. FTMO 2-step daily limit is 5%.")
acctSize   = input.float(100000, "Account size", minval = 100, group = g_prop)
maxDDlock  = input.float(10.0, "Account max loss lock (%)", minval = 1, step = 0.5, group = g_prop)
entryStartMin = input.int(600, "Entry start (minutes from midnight, 600 = 10:00)",
         minval = 0, maxval = 1439, group = g_prop)
entryEndMin   = input.int(945, "Entry end (minutes from midnight, 945 = 15:45)",
         minval = 0, maxval = 1439, group = g_prop)
flattenMin    = input.int(955, "Flatten all (minutes from midnight, 955 = 15:55)",
         minval = 0, maxval = 1439, group = g_prop)
minRunway     = input.int(45, "Min minutes left in session to open a trade", minval = 0,
         maxval = 300, group = g_prop)

g_view = "5) Display"
showVwap = input.bool(true, "Show VWAP",      group = g_view)
showDash = input.bool(true, "Show dashboard", group = g_view)

// -----------------------------------------------------------------------------
// 2. SESSION HELPERS
// -----------------------------------------------------------------------------
// time(timeframe.session, session) -> constant UNIX time of the session start
sessStart = time(timeframe.session, sessTZ)
isNewSess = barstate.isfirst or (not na(sessStart) and (na(sessStart[1]) or sessStart != sessStart[1]))

// -----------------------------------------------------------------------------
// 3. LAYER 1 - SQUEEZE MOMENTUM (LazyBear)
// -----------------------------------------------------------------------------
// NOTE: the original LazyBear code had `dev = multKC * stdev(...)` (a typo fixed
// on 29 Sep 2014). The fixed source uses the Bollinger multiplier.
basis   = ta.sma(close, bbLen)
dev     = bbMult * ta.stdev(close, bbLen)
upperBB = basis + dev
lowerBB = basis - dev

kcMa    = ta.sma(close, kcLen)
kcRng   = ta.sma(ta.tr(true), kcLen)
upperKC = kcMa + kcRng * kcMult
lowerKC = kcMa - kcRng * kcMult

sqzOn   = (lowerBB > lowerKC) and (upperBB < upperKC)   // black cross (compression)
sqzOff  = (lowerBB < lowerKC) and (upperBB > upperKC)   // grey cross  (expansion)

hh      = ta.highest(high, kcLen)
ll      = ta.lowest(low,  kcLen)
mid     = ta.sma(close, kcLen)
mom     = ta.linreg(close - ta.avg(ta.avg(hh, ll), mid), kcLen, 0)

release = sqzOff and sqzOn[1]        // FIRST bar after a squeeze -> the trigger

// -----------------------------------------------------------------------------
// 4. LAYER 2 - SESSION VWAP BIAS
// -----------------------------------------------------------------------------
var float cumPV = 0.0
var float cumV  = 0.0
if isNewSess
    cumPV := 0.0
    cumV  := 0.0
cumPV += ta.typicalprice * volume
cumV  += volume
vwapVal = cumV > 0 ? cumPV / cumV : na

// -----------------------------------------------------------------------------
// 5. LAYER 3 - HTF TREND (last CLOSED htf bar only -> no repaint)
// -----------------------------------------------------------------------------
htfEma1 = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfLen)[1], lookahead = barmerge.lookahead_on)
htfEma2 = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfLen)[2], lookahead = barmerge.lookahead_on)
htfUp   = htfEma1 > htfEma2

// -----------------------------------------------------------------------------
// 6. RISK
// -----------------------------------------------------------------------------
atr = ta.atr(atrLen)

// -----------------------------------------------------------------------------
// 7. SESSION WINDOW
// -----------------------------------------------------------------------------
minuteOfDay = hour(timeframe.period, sessTZ) * 60 + minute(timeframe.period, sessTZ)
inSession   = minuteOfDay >= entryStartMin and minuteOfDay <= entryEndMin
hasRunway   = flattenMin - minuteOfDay >= minRunway
endOfDay    = minuteOfDay >= flattenMin

// -----------------------------------------------------------------------------
// 8. SIGNALS
// -----------------------------------------------------------------------------
longBase  = release and mom > 0 and inSession and hasRunway
shortBase = release and mom < 0 and inSession and hasRunway

if momK > 0
    longBase  := longBase  and math.abs(mom) >= momK * atr
    shortBase := shortBase and math.abs(mom) >= momK * atr

if momSlope
    longBase  := longBase  and mom > mom[1]
    shortBase := shortBase and mom < mom[1]

if useVwap
    longBase  := longBase  and close > vwapVal
    shortBase := shortBase and close < vwapVal

if useHtf
    longBase  := longBase  and htfUp
    shortBase := shortBase and not htfUp

// -----------------------------------------------------------------------------
// 9. PROP-FIRM STATE
// -----------------------------------------------------------------------------
var float dayStartEquity = strategy.initial_capital
var int   tradesToday    = 0
var bool  dayLocked      = false
var float dayPnl         = 0.0
var float bestDay        = 0.0
var float totalProfit    = 0.0
var float lastDayPnl     = 0.0

if isNewSess
    lastDayPnl := dayPnl
    if lastDayPnl > bestDay
        bestDay := lastDayPnl
    totalProfit   += dayPnl
    dayStartEquity := strategy.equity
    dayPnl        := 0.0
    tradesToday   := 0
    dayLocked     := false

dayPnl := strategy.equity - dayStartEquity

// hard account guard - never let the account go past the firm's max loss
if strategy.equity <= acctSize * (1 - maxDDlock / 100)
    strategy.close_all(comment = "MAX LOSS LOCK")
    dayLocked := true

// daily loss lock
if dayPnl <= -acctSize * dailyStopPct / 100
    if strategy.position_size != 0
        strategy.close_all(comment = "DAILY LOSS LOCK")
    dayLocked := true

// flatten before the close - no overnight risk on a prop account
if endOfDay and strategy.position_size != 0
    strategy.close_all(comment = "EOD FLAT")

// -----------------------------------------------------------------------------
// 10. EXECUTION
// -----------------------------------------------------------------------------
stopDist = atr * stopMult
qty      = stopDist > 0 ? math.floor((strategy.equity * riskPct / 100) / stopDist) : 0

canTrade = strategy.position_size == 0 and not dayLocked and tradesToday < maxTradesDay and qty >= 1

if canTrade and longBase
    strategy.entry("Long", strategy.long, qty = qty)
    strategy.exit("Long X", "Long", stop = close - stopDist, limit = close + stopDist * rr)
    tradesToday += 1

if canTrade and shortBase
    strategy.entry("Short", strategy.short, qty = qty)
    strategy.exit("Short X", "Short", stop = close + stopDist, limit = close - stopDist * rr)
    tradesToday += 1

// -----------------------------------------------------------------------------
// 11. PLOTS / TABLE / ALERTS
// -----------------------------------------------------------------------------
plot(sqzOn ? 0 : sqzOff ? 1 : 2, "Squeeze state", style = plot.style_circles,
     color = sqzOn ? color.black : sqzOff ? color.gray : color.blue,
     linewidth = 3, transp = 100)
if showVwap
    plot(vwapVal, "Session VWAP", color = color.orange, linewidth = 2)
plot(atr, "ATR", color = color.new(color.purple, 80), linewidth = 1)

plotshape(longBase and canTrade,  "Long",  shape.triangleup,   location.belowbar, color.lime, size = size.tiny)
plotshape(shortBase and canTrade, "Short", shape.triangledown, location.abovebar, color.red,   size = size.tiny)

alertcondition(longBase,  "VWAP-Squeeze LONG",         "VWAP+Squeeze LONG")
alertcondition(shortBase, "VWAP-Squeeze SHORT",        "VWAP+Squeeze SHORT")
alertcondition(dayLocked, "Prop-firm day locked",       "Daily loss lock - no more trades today")

if showDash
    var table dash = table.new(position.top_right, 3, 7, border_width = 1)
    if barstate.islast
        consRatio = totalProfit > 0 ? bestDay / totalProfit * 100 : na
        table.cell(dash, 0, 0, "PROP DASH", bgcolor = color.new(color.black, 20), text_color = color.white)
        table.cell(dash, 1, 0, "Equity", text_color = color.white)
        table.cell(dash, 2, 0, str.tostring(strategy.equity, "#.##"), text_color = color.white)
        table.cell(dash, 1, 1, "Day P&L", text_color = color.white)
        table.cell(dash, 2, 1, str.tostring(dayPnl, "#.##"), text_color = dayPnl >= 0 ? color.lime : color.red)
        table.cell(dash, 1, 2, "Trades today", text_color = color.white)
        table.cell(dash, 2, 2, str.tostring(tradesToday) + " / " + str.tostring(maxTradesDay), text_color = color.white)
        table.cell(dash, 1, 3, "Day lock", text_color = color.white)
        table.cell(dash, 2, 3, dayLocked ? "LOCKED" : "open", text_color = dayLocked ? color.red : color.lime)
        table.cell(dash, 1, 4, "Best day %", text_color = color.white)
        table.cell(dash, 2, 4, na(consRatio) ? "n/a" : str.tostring(consRatio, "#.#") + "%",
             text_color = na(consRatio) ? color.white : (consRatio <= 30 ? color.lime : color.orange))
        table.cell(dash, 1, 5, "ATR stop", text_color = color.white)
        table.cell(dash, 2, 5, str.tostring(stopDist, "#.##"), text_color = color.white)
        table.cell(dash, 1, 6, "Risk/trade", text_color = color.white)
        table.cell(dash, 2, 6, str.tostring(riskPct, "#.##") + "%  =  $" +
             str.tostring(strategy.equity * riskPct / 100, "#.#"), text_color = color.white)
